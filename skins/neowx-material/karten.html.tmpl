<script>
function toggleRadar(elementId, staticUrl, gifUrl) {
    var img = document.getElementById(elementId);
    // Prüfen, ob aktuell das statische Bild angezeigt wird
    if (img.src.indexOf(staticUrl) !== -1) {
        img.src = gifUrl; // Zu GIF wechseln
    } else {
        img.src = staticUrl; // Zurück zum Standbild
    }
}
</script>
